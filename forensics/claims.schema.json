{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pencil-blade.invalid/forensics/claims.schema.json",
  "title": "Pencil Blade evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim",
    "status",
    "evidenceTier",
    "evidenceRefs",
    "confidence",
    "contractEligible",
    "contradictionIds",
    "reviewer",
    "reviewDate"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CLM-[A-Z0-9][A-Z0-9-]*$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["recovered", "inferred", "unknown"]
    },
    "evidenceTier": {
      "type": "integer",
      "enum": [1, 2, 3, 4]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(SRC|DER)-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "contractEligible": {
      "type": "boolean",
      "description": "True only when Tier 1 or Tier 2 evidence supports an implementation contract."
    },
    "contradictionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewDate": {
      "type": "string",
      "format": "date"
    },
    "nativeAddresses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^0x[0-9A-Fa-f]+$"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"contractEligible": {"const": true}},
        "required": ["contractEligible"]
      },
      "then": {
        "properties": {
          "evidenceTier": {"enum": [1, 2]},
          "status": {"enum": ["recovered"]}
        }
      }
    }
  ]
}
