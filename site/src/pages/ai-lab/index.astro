---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/base-layout.astro";
import AssistanceDisclosure from "../../components/ai-lab/assistance-disclosure.astro";
import EpisodeCard from "../../components/ai-lab/episode-card.astro";
import RightsBoundary from "../../components/editorial/rights-boundary.astro";
import {
  buildAiLabIndex,
  getAiLabPublicationManifest,
  aiLabEvidenceSnapshotId,
  type AiEpisodeRecord,
} from "../../data/ai-lab/index.ts";
import { withBase } from "../../data/routes.ts";

const records = (await getCollection("aiEpisodes"))
  .filter((entry) => entry.data.locale === "en")
  .map((entry) => entry.data as AiEpisodeRecord);
const episodes = buildAiLabIndex(getAiLabPublicationManifest(), records);
const title = "AI Lab · Curated evidence decisions";
const description = "Six source-backed episodes show bounded AI assistance, typed review decisions, verification, corrections, and visible limits—never raw transcripts.";
---

<BaseLayout
  locale="en"
  route="/ai-lab/"
  routeId="ai-lab.en"
  title={title}
  description={description}
  surface="lab"
>
  <article class="ai-lab">
    <header class="hero">
      <p class="eyebrow">Chapter 5 · snapshot {aiLabEvidenceSnapshotId}</p>
      <h1>AI participated in the work. It did not become the authority.</h1>
      <p class="hero__lede">
        Six edited investigations trace questions through canonical claims, public-safe sources,
        typed decisions, implementation boundaries, deterministic checks, and corrections.
      </p>
      <p><a href={withBase("/evidence/")}>Open all 39 canonical evidence records <span aria-hidden="true">→</span></a></p>
    </header>

    <AssistanceDisclosure locale="en" />

    <section aria-labelledby="episodes-heading">
      <p class="eyebrow">Curated episodes</p>
      <h2 id="episodes-heading">From proposal to evidence-backed boundary</h2>
      <div class="ai-lab__episodes">
        {episodes.map((episode) => <EpisodeCard episode={episode} />)}
      </div>
    </section>

    <RightsBoundary
      technical="Each episode joins canonical claim state from the generated frozen snapshot and cites only allowlisted public-source IDs."
      academic="Phase 5 publishes editorial text and CSS only. It creates no media record and claims no standalone recovered-media display scope."
      commercial="The separate commercial-rights manifest remains blocked. Technical verification and academic display do not change it."
    />
  </article>
</BaseLayout>

<style>
  .ai-lab {
    display: grid;
    gap: var(--space-7);
  }

  .ai-lab__episodes {
    display: grid;
    gap: var(--space-6);
  }
</style>
