---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/base-layout.astro";
import EvidenceStatus from "../../components/evidence/evidence-status.astro";
import RightsLabels from "../../components/ai-lab/rights-labels.astro";
import {
  buildEvidenceExplorerEntries,
  resolveRightsLabels,
  type EvidenceExplorerEntry,
} from "../../data/ai-lab/index.ts";
import { withBase } from "../../data/routes.ts";

export function getStaticPaths() {
  return buildEvidenceExplorerEntries("en").map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: EvidenceExplorerEntry;
}

const { entry } = Astro.props;
const relatedEpisodes = (await getCollection("aiEpisodes", ({ data }) =>
  data.locale === "en" && !data.draft && data.evidence.includes(entry.id)))
  .sort((left, right) => left.data.order - right.data.order);
const rights = resolveRightsLabels();
const title = `${entry.id} · Evidence Explorer`;
---

<BaseLayout locale="en" route={`/evidence/${entry.id}/`} routeId="evidence.detail.en" title={title} description={entry.excerpt}>
  <article class="evidence-detail">
    <header class="hero">
      <p class="eyebrow">{entry.chapter} · {entry.sourceType}</p>
      <h1>{entry.id}</h1>
      <EvidenceStatus status={entry.status} />
      <p class="hero__lede">{entry.copy}</p>
      <p>{entry.qualifier}</p>
    </header>

    <section aria-labelledby="authority-heading">
      <h2 id="authority-heading">Canonical authority</h2>
      <p>{entry.explanation}</p>
      <dl class="evidence-detail__ledger">
        <div><dt>Evidence tier</dt><dd>{entry.evidenceTier}</dd></div>
        <div><dt>Confidence</dt><dd>{entry.confidence}</dd></div>
        <div><dt>Contract eligible</dt><dd>{String(entry.contractEligible)}</dd></div>
        <div><dt>Verification</dt><dd>{entry.verificationType}</dd></div>
        <div><dt>Redaction</dt><dd>{entry.redactionDisposition}: {entry.redactionReason}</dd></div>
      </dl>
    </section>

    <section aria-labelledby="refs-heading">
      <h2 id="refs-heading">Evidence and source references</h2>
      <p><strong>Canonical evidence IDs:</strong> {entry.evidenceRefs.join(", ")}</p>
      <ul>
        {entry.sources.map((source) => (
          <li id={`source-${source.sourceId}`}>
            <code>{source.sourceId}</code>
            <p>{source.excerpt}</p>
            {source.href && <a href={source.href}>Open commit-pinned source</a>}
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="episodes-heading">
      <h2 id="episodes-heading">Related curated episodes</h2>
      {relatedEpisodes.length > 0
        ? <ul>{relatedEpisodes.map((episode) => <li><a href={withBase(`/ai-lab/${episode.data.id}/`)}>{episode.data.question}</a></li>)}</ul>
        : <p>No AI Lab episode uses this claim. The record remains available in the complete static index.</p>}
    </section>

    <RightsLabels rights={rights} />
    <p><a href={withBase(`/evidence/#${entry.id}`)}>Back to the explorer index</a></p>
  </article>
</BaseLayout>

<style>
  .evidence-detail {
    display: grid;
    gap: var(--space-7);
  }

  .evidence-detail__ledger {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-3);
  }

  .evidence-detail__ledger div {
    border-top: var(--line);
    padding-top: var(--space-2);
  }

  .evidence-detail__ledger dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
  }

  .evidence-detail__ledger dd {
    margin: 0;
    font-weight: 800;
  }
</style>
