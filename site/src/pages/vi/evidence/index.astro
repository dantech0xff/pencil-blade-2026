---
import BaseLayout from "../../../layouts/base-layout.astro";
import EvidenceCard from "../../../components/evidence-explorer/evidence-card.astro";
import ExplorerFilters from "../../../components/evidence-explorer/explorer-filters.astro";
import StatusLegend from "../../../components/evidence/status-legend.astro";
import {
  buildEvidenceExplorerEntries,
  buildExplorerFilters,
  aiLabEvidenceSnapshotId,
} from "../../../data/ai-lab/index.ts";
import { withBase } from "../../../data/routes.ts";

const entries = buildEvidenceExplorerEntries("vi");
const facets = buildExplorerFilters(entries);
const title = "Evidence Explorer · 39 bản ghi chuẩn";
const description = "Chỉ mục static-first có thể lọc cho các tuyên bố chuẩn, nguồn, kiểm chứng, phạm vi hiển thị học thuật và trạng thái quyền thương mại.";
---

<BaseLayout locale="vi" route="/evidence/" routeId="evidence.vi" title={title} description={description}>
  <article class="evidence-explorer" data-evidence-explorer>
    <header class="hero">
      <p class="eyebrow">Phép chiếu đóng băng · {aiLabEvidenceSnapshotId}</p>
      <h1>Bằng chứng vẫn đọc được trước khi trở thành bộ lọc.</h1>
      <p class="hero__lede">Toàn bộ 39 bản ghi chuẩn xuất hiện theo thứ tự xác định trong HTML tĩnh. JavaScript tùy chọn chỉ lọc danh sách và tuần tự hóa trạng thái vào URL.</p>
      <p><a href={withBase("/vi/ai-lab/")}>Xem các bản ghi được chọn đã định hình các tập có AI hỗ trợ như thế nào <span aria-hidden="true">→</span></a></p>
    </header>

    <StatusLegend locale="vi" />
    <ExplorerFilters facets={facets} locale="vi" />
    <noscript><p class="draft-flag">JavaScript đang tắt. Danh sách bằng chứng đầy đủ vẫn có ở dưới; bộ lọc chỉ là phần tăng cường tùy chọn.</p></noscript>

    <section class="evidence-explorer__list" aria-label="Các bản ghi bằng chứng chuẩn">
      {entries.map((entry) => <EvidenceCard entry={entry} />)}
    </section>
  </article>
</BaseLayout>

<style>
  .evidence-explorer {
    display: grid;
    gap: var(--space-6);
  }

  .evidence-explorer__list {
    display: grid;
    gap: var(--space-5);
  }
</style>
