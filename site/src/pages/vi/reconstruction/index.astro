---
import { getCollection, getEntry } from "astro:content";

import BaseLayout from "../../../layouts/base-layout.astro";
import ChapterPage from "../../../components/chapter/chapter-page.astro";
import sourceCatalog from "../../../../../reference/case-study-public-source-catalog.json";
import manifest from "../../../../../reference/case-study-publication-manifest.json";

const chapter = await getEntry("chapters", "reconstruction.vi");
if (!chapter) throw new Error("Missing Vietnamese Reconstruction chapter.");
const generatedFacts = await getCollection("claimPresentations");
const localeReviewPending =
  manifest.releaseInputs.vietnameseFactualReview.evidenceStatus !== "confirmed";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: chapter.data.title,
  description: chapter.data.seoDescription,
  inLanguage: "vi",
  isAccessibleForFree: true,
};
---

<BaseLayout
  locale="vi"
  route="/reconstruction/"
  routeId="reconstruction.vi"
  title={chapter.data.seoTitle}
  description={chapter.data.seoDescription}
  structuredData={structuredData}
>
  <ChapterPage
    chapter={chapter}
    route={{
      id: "reconstruction.vi",
      path: "/vi/reconstruction/",
      nextPath: null,
      nextLabel: null,
    }}
    generatedFacts={generatedFacts}
    publicEvidenceIndex={sourceCatalog.sources}
    localeReviewPending={localeReviewPending}
  />
</BaseLayout>
