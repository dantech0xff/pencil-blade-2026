---
import BaseLayout from "../../../layouts/base-layout.astro";
import EvidenceStatus from "../../../components/evidence/evidence-status.astro";
import RightsBoundary from "../../../components/editorial/rights-boundary.astro";
import manifest from "../../../../../reference/case-study-publication-manifest.json";

const release = manifest.releaseInputs;
const blocked = release.candidateStatus !== "ready"
  || release.accountableReleaseOwner.evidenceStatus !== "confirmed"
  || release.vietnameseFactualReview.evidenceStatus !== "confirmed"
  || release.publicCorrections.channelStatus !== "confirmed";
const title = "Giới thiệu hồ sơ Pencil Blade";
const description = "Phương pháp, phạm vi, ghi công, kênh chỉnh sửa, trách nhiệm bản dịch và giới hạn quyền xuất bản.";
---

<BaseLayout locale="vi" route="/about/" title={title} description={description}>
  <article>
    <p class="eyebrow">Phương pháp và trách nhiệm</p>
    <h1>{title}</h1>
    {blocked && (
      <p class="draft-flag">
        Bản nháp chưa thể phát hành: vẫn thiếu bằng chứng về chủ sở hữu trách nhiệm, xác nhận kênh
        chỉnh sửa và người duyệt dữ kiện tiếng Việt.
      </p>
    )}
    <section>
      <h2>Phương pháp</h2>
      <p>APK gốc chưa từng được cài đặt hay chạy. Hồ sơ tách biệt bằng chứng tĩnh, hợp đồng hành vi đã duyệt, triển khai clean-room, kiểm thử xác định và kiểm chứng runtime của bản phục dựng.</p>
    </section>
    <section>
      <h2>Phạm vi và liên kết</h2>
      <p>{release.attributionTemplate.vi}</p>
      <p>Không trang nào tuyên bố đã phục hồi mã nguồn C++ gốc hay danh tính runtime gốc.</p>
    </section>
    <RightsBoundary
      locale="vi"
      technical="Repository có thể chứng minh nội dung đã phục dựng và hành vi của bản dựng phục dựng khi kiểm toán."
      academic="Quyết định miễn trừ của chủ sở hữu bao phủ đúng bản demo H5 đã kiểm toán và sáu ảnh runtime phục dựng có hash cho hiển thị học thuật/phi thương mại."
      commercial="Bản ghi quyền vẫn fail-closed. Không tuyên bố đã có quyền phân phối thương mại."
    />
    <section>
      <h2>Ghi công và trách nhiệm phát hành</h2>
      <dl>
        <dt>Chủ sở hữu trách nhiệm phát hành</dt>
        <dd><EvidenceStatus status="blocked" locale="vi" /> Đang chờ bằng chứng; không tự tạo tên.</dd>
        <dt>Người duyệt dữ kiện tiếng Việt</dt>
        <dd><EvidenceStatus status="blocked" locale="vi" /> Đang chờ bằng chứng; các qualifier bản dịch chưa được duyệt phát hành.</dd>
      </dl>
    </section>
    <section>
      <h2>Chỉnh sửa</h2>
      <p>
        Kênh đề xuất: <a href={release.publicCorrections.channel}>GitHub Issues</a>.
        Trạng thái hiện tại là <strong>{release.publicCorrections.channelStatus}</strong>; chế độ
        candidate bị chặn cho tới khi có chủ sở hữu trách nhiệm xác nhận.
      </p>
    </section>
  </article>
</BaseLayout>
