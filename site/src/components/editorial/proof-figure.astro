---
interface Props {
  src: string;
  alt: string;
  longDescription: string;
  caption: string;
  provenance: string;
  mediaId: string;
  width: number;
  height: number;
}

const {
  src,
  alt,
  longDescription,
  caption,
  provenance,
  mediaId,
  width,
  height,
} = Astro.props;
---

<figure class="proof-figure" data-media-id={mediaId}>
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  <figcaption>
    <p>{caption}</p>
    <details>
      <summary>Long description</summary>
      <p>{longDescription}</p>
    </details>
    <p class="micro-label">Provenance: {provenance} · {mediaId}</p>
  </figcaption>
</figure>
