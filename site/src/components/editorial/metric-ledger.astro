---
interface Props {
  label: string;
  numerator: number | string;
  denominator: number | string;
  version: string;
  date: string;
  qualifier: string;
  source: string;
}

const { label, numerator, denominator, version, date, qualifier, source } = Astro.props;
---

<article class="ledger-card">
  <p class="micro-label">{label}</p>
  <strong>{numerator} / {denominator}</strong>
  <p>{qualifier}</p>
  <p><small>{version} · <time datetime={date}>{date}</time> · {source}</small></p>
</article>
