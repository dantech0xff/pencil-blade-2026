---
import type { Locale } from "../../data/locales.ts";

interface Props {
  id: string;
  locale?: Locale;
  label?: string;
}

const { id, locale = "en", label = id } = Astro.props;
const referenceLabel = locale === "vi" ? "Bằng chứng" : "Evidence";
---

<span class="evidence-ref" role="note" data-evidence-ref={id}>
  <span class="evidence-ref__label">{referenceLabel}</span>
  <code translate="no">{label}</code>
</span>

<style>
  .evidence-ref {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-2);
    border-left: 0.25rem solid var(--pencil);
    padding: var(--space-2) var(--space-3);
    color: var(--graphite);
    background: color-mix(in srgb, var(--pencil) 13%, var(--paper));
  }

  .evidence-ref__label {
    font-family: var(--font-mono);
    font-weight: 800;
  }
</style>
