---
interface Props {
  locale?: "en" | "vi";
}

const { locale = "en" } = Astro.props;
const copy = locale === "vi"
  ? {
      eyebrow: "Quy tắc công bố",
      title: "AI hỗ trợ xử lý; bằng chứng và kiểm thử giữ thẩm quyền.",
      body:
        "Các hồ sơ này là bản biên tập có nguồn, không phải kho hội thoại. Chúng chỉ công bố câu hỏi, bằng chứng, giả thuyết, quyết định rà soát có kiểu, ranh giới triển khai, kiểm chứng và giới hạn.",
      excluded:
        "Không công bố hội thoại thô, prompt ẩn hoặc hệ thống, chain-of-thought, tên model chưa được xác minh hay ghi chú rà soát riêng tư.",
    }
  : {
      eyebrow: "Disclosure rule",
      title: "AI assisted processing; evidence and tests retained authority.",
      body:
        "These are edited, source-backed case files—not a conversation archive. They disclose only the question, evidence, hypothesis, typed review decision, implementation boundary, verification, and limit.",
      excluded:
        "Raw chats, hidden or system prompts, chain-of-thought, unverified model names, and private review notes are excluded.",
    };
---

<aside class="assistance-disclosure" aria-labelledby="ai-disclosure-heading">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h2 id="ai-disclosure-heading">{copy.title}</h2>
  <p>{copy.body}</p>
  <p class="assistance-disclosure__limit">{copy.excluded}</p>
</aside>

<style>
  .assistance-disclosure {
    border: 2px solid var(--graphite);
    border-left: 0.5rem solid var(--measured);
    padding: var(--space-5);
    color: var(--white);
    background: var(--lab);
  }

  .assistance-disclosure__limit {
    color: color-mix(in srgb, var(--white) 76%, var(--pencil));
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
</style>
