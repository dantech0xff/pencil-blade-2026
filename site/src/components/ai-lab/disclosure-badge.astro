---
import type { DisclosurePresentation } from "../../data/ai-lab/index.ts";

interface Props {
  disclosure: DisclosurePresentation;
  locale?: "en" | "vi";
}

const { disclosure, locale = "en" } = Astro.props;
---

<dl class="disclosure-badge" data-actor-kind={disclosure.actorKind}>
  <div>
    <dt>{locale === "vi" ? "Hỗ trợ" : "Assistance"}</dt>
    <dd>{disclosure.assistanceLabel}</dd>
  </div>
  <div>
    <dt>{locale === "vi" ? "Tác nhân quyết định" : "Decision actor"}</dt>
    <dd><code>{disclosure.actorKind}</code></dd>
  </div>
  <div>
    <dt>{locale === "vi" ? "Tham chiếu quyết định" : "Decision reference"}</dt>
    <dd><code>{disclosure.decisionRef}</code></dd>
  </div>
</dl>

<style>
  .disclosure-badge {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-3);
    margin-block: var(--space-4);
  }

  .disclosure-badge div {
    border-top: 1px solid currentColor;
    padding-top: var(--space-2);
  }

  .disclosure-badge dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 800;
    text-transform: uppercase;
  }

  .disclosure-badge dd {
    margin: 0;
  }
</style>
