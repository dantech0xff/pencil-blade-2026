---
import type { AiEpisodeRecord } from "../../data/ai-lab/index.ts";

interface Props {
  episode: AiEpisodeRecord;
}

const { episode } = Astro.props;
const vi = episode.locale === "vi";
const steps = [
  [vi ? "Câu hỏi" : "Question", episode.question],
  [vi ? "Giả thuyết" : "Hypothesis", episode.hypothesis],
  [vi ? "Quyết định rà soát" : "Review decision", episode.reviewDecision],
  [vi ? "Ranh giới triển khai" : "Implementation boundary", episode.implementation],
  [vi ? "Kiểm chứng" : "Verification", episode.verification],
  [vi ? "Sửa sai / giới hạn" : "Correction / limit", episode.failureLesson],
] as const;
---

<ol class="episode-timeline">
  {steps.map(([label, body]) => (
    <li>
      <p class="micro-label">{label}</p>
      <p>{body}</p>
    </li>
  ))}
</ol>

<style>
  .episode-timeline {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    counter-reset: timeline;
    list-style: none;
  }

  .episode-timeline li {
    position: relative;
    border-left: 0.35rem solid var(--measured);
    padding: var(--space-4) var(--space-5);
    background: color-mix(in srgb, var(--paper) 92%, var(--white));
    counter-increment: timeline;
  }

  .episode-timeline li::before {
    position: absolute;
    inset: var(--space-4) auto auto -1.15rem;
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    place-items: center;
    border: 2px solid var(--graphite);
    border-radius: 50%;
    color: var(--graphite);
    background: var(--pencil);
    content: counter(timeline);
    font: 800 var(--step--1) / 1 var(--font-mono);
  }
</style>
