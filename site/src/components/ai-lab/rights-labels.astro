---
import type { RightsLabels } from "../../data/ai-lab/index.ts";

interface Props {
  rights: RightsLabels;
  locale?: "en" | "vi";
}

const { rights, locale = "en" } = Astro.props;
---

<dl class="rights-labels">
  <div>
    <dt>{locale === "vi" ? "Hiển thị học thuật" : "Academic display"}</dt>
    <dd>
      {rights.academicDisplay.label[locale]}
      <code>{rights.academicDisplay.ref}</code>
    </dd>
  </div>
  <div>
    <dt>{locale === "vi" ? "Quyền thương mại" : "Commercial rights"}</dt>
    <dd>
      {rights.commercialRights.label[locale]}
      <code>{rights.commercialRights.ref}</code>
    </dd>
  </div>
</dl>

<style>
  .rights-labels {
    display: grid;
    gap: var(--space-3);
  }

  .rights-labels div {
    border: 1px solid currentColor;
    padding: var(--space-3);
  }

  .rights-labels dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 800;
    text-transform: uppercase;
  }

  .rights-labels dd {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .rights-labels code {
    overflow-wrap: anywhere;
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    .rights-labels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
